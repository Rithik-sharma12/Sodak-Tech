# Copy to .env and fill in. Never commit .env.
#
# SODAK-TECH-STACK.md §5.6: "Secrets in a managed secret store, injected at
# runtime. Never in images, repositories, or environment files under version
# control." This file is the local-development shape of that contract, and it
# holds no real values.

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Deliberately NOT Django's get_random_secret_key(): its alphabet includes '$',
# and Docker Compose treats '$' in a .env value as variable interpolation, so
# the key silently arrives truncated. token_urlsafe gives equivalent entropy
# with no characters that Compose, shells, or CI will reinterpret.
DJANGO_SECRET_KEY=replace-me-with-a-64-byte-url-safe-random-string

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local Compose values. In production these come from the secret store and
# point at the managed services.
DATABASE_URL=postgres://sodak:sodak@localhost:5432/sodak
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# --- Timeouts (§4.2: an unbounded wait is the most common cause of cascading
# failure) ---
DB_CONNECT_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=3
REDIS_SOCKET_TIMEOUT=3
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540

# --- Bounded queues (§4.1: the single most important stability control) ---
MAX_SUBMISSION_BYTES=65536
MAX_INFLIGHT_SUBMISSIONS_PER_USER=3
MAX_QUEUE_DEPTH_PRACTICE=5000
MAX_QUEUE_DEPTH_CONTEST=20000

# --- Integrity (§8.5: prevents binary-searching hidden tests by probing) ---
SUBMISSION_COOLDOWN_SECONDS=5

# --- Editorial gating (§3.6) ---
EDITORIAL_UNLOCK_ATTEMPTS=3
EDITORIAL_UNLOCK_COOLDOWN_HOURS=24
EDITORIAL_SCORE_MULTIPLIER=0.5
HINT_SCORE_MULTIPLIER=0.8

# --- Sessions (§8.3: privileged sessions are shorter than learner sessions) ---
SESSION_COOKIE_AGE=1209600
PRIVILEGED_SESSION_COOKIE_AGE=14400
REAUTH_WINDOW_SECONDS=900

# Speeds up the test suite by swapping Argon2 for a fast hasher. Dev only.
USE_FAST_HASHING=false
